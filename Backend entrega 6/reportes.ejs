<h1>Reportes</h1>

<form action="/reportes/crear" method="POST">

    <input type="text" name="titulo" placeholder="Título">

    <textarea name="descripcion"></textarea>

    <select name="tipo">
        <option>PLD</option>
        <option>Fraude</option>
        <option>Sistema</option>
    </select>

    <select name="prioridad">
        <option>Alta</option>
        <option>Media</option>
        <option>Baja</option>
    </select>

    <button type="submit">
        Crear Reporte
    </button>

</form>

<hr>

<table border="1">

<tr>
    <th>Título</th>
    <th>Tipo</th>
    <th>Prioridad</th>
    <th>Estatus</th>
</tr>

<% reportes.forEach(reporte => { %>

<tr>
    <td><%= reporte.titulo %></td>
    <td><%= reporte.tipo %></td>
    <td><%= reporte.prioridad %></td>
    <td><%= reporte.estatus %></td>
</tr>

<% }) %>

</table>