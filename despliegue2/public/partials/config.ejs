<div id="configOverlay" class="overlay"></div>

<div id="configPanel" class="config-panel">

    <div class="config-header">

        <h2>Configuración</h2>

        <button id="closeConfig"  type="button">
            &times;
        </button>

    </div>

    <div class="config-content">

        <div class="config-section">

            <h3>Tema</h3>

            <a>Cambiar tema</a>

        </div>

        <div class="config-section">

            <h3>Cuenta</h3>

            <a>Cerrar sesión</a>

        </div>

        <div class="config-section">

            <h3>Notificaciones</h3>

            <label>
                <input type="checkbox">
                Activar alertas
            </label>

        </div>

    </div>

</div>