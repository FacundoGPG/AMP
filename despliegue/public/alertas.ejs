<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />   
     <link rel="stylesheet" href="./styles.css"> 
    <title>Alertas - Beta 1 </title>
</head>
<body>
  <%- include("partials/topbar") %>
  <%- include("partials/sidebar") %>
  <%- include("partials/config") %>
  <div id="overlay" class="overlay"></div>

 
 <main class="dashboard">
  <!-- FILTROS -->
  <section class="panel full">
  <div class="panel-header">
    <h5>Filtros</h5>
    <button type="button" id="clearFilters" class="btn btn-light">Limpiar filtros</button>
  </div>

  <div class="filters">
    <input id="searchClient" type="text" placeholder="Buscar por cliente o ID">

    <input id="dateFrom" type="date">
    <input id="dateTo" type="date">

    <select id="filterType">
      <option value="">Selecciona Tipo de Alerta</option>
      <option value="Transaccion">Transaccion</option>
      <option value="Identidad">Identidad</option>
      <option value="Fraude">Fraude</option>
      <option value="Cumplimiento">Cumplimiento</option>
    </select>

    <select id="filterStatus">
      <option value="">Estatus</option>
      <option value="En revisión">En Revision</option>
      <option value="Cerrada">Cerrada</option>
      <option value="Abierta">Abierta</option>
    </select>

    <button type= "button" id="applyFilters" class="btn btn-dark">Filtrar</button>
    </div>
  </section>

  <!-- TABLA PRINCIPAL -->
  <section class="panel full-page">
    <div class="panel-header">
      <h5>Listado de Alertas</h5>
      <button type="button" id="exportAlertasCSV" class="btn btn-light">Exportar CSV</button>
    </div>
      <div id="alertas-table"></div>
  </section>
</main>  
  <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
  <script src="./scripts/filtros.js"></script>
  <script src="./scripts/exportar-csv.js"></script>
  <script src="./scripts/alertas.js"></script>
  <script src="./scripts/componentes.js"></script>

</body>
</html>
