<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css">
    <title>Gestión de Usuarios</title>
</head>
<body>
  
  <%- include("partials/topbar") %>
  <%- include("partials/sidebar") %>
  <%- include("partials/config") %>
  <%- include("partials/panelUsuario") %>
  <div id="overlay" class="overlay"></div>

  <main class="dashboard">

    <div class="card">
        <h5 class="card-title">Total de Usuarios</h5>
        <p class="card-nmb" id="total-usuarios">--</p>
    </div>
    <div class="card">
        <h5 class="card-title">Clientes</h5>
        <p class="card-nmb" id="total-clientes-usr">--</p>
    </div>
    <div class="card">
        <h5 class="card-title">Empleados</h5>
        <p class="card-nmb" id="total-empleados">--</p>
    </div>
    <div class="card">
        <h5 class="card-title">Oficiales</h5>
        <p class="card-nmb" id="total-oficiales">--</p>
    </div>

    <section class="panel full-page">
      <div class="clientes-header">
        <div class="clientes-tabs">
          <button class="tab-btn active" data-table="usuarios-section">Usuarios</button>
          <button class="tab-btn" data-table="crear-section">Crear usuario</button>
        </div>
      </div>

      <!-- TAB: LISTADO -->
      <div id="usuarios-section" class="table-section active">
        <h2>Listado de usuarios</h2>
        <div id="usuarios-table"></div>
      </div>

      <!-- TAB: CREAR -->
      <div id="crear-section" class="table-section">
        <h2>Crear nuevo usuario</h2>
        <div class="panel full" style="max-width: 480px; margin-top: 1rem;">
          <div class="form-field">
            <label>Nombre</label>
            <input type="text" id="crear-nombre" class="form-control" placeholder="Nombre">
          </div>
          <div class="form-field">
            <label>Apellido</label>
            <input type="text" id="crear-apellido" class="form-control" placeholder="Apellido">
          </div>
          <div class="form-field">
            <label>Correo</label>
            <input type="email" id="crear-correo" class="form-control" placeholder="correo@ejemplo.com">
          </div>
          <div class="form-field">
            <label>Contraseña</label>
            <input type="password" id="crear-contrasena" class="form-control" placeholder="Contraseña">
          </div>
          <div class="form-field">
            <label>Rol</label>
            <select id="crear-rol" class="form-select">
              <option value="">Selecciona un rol</option>
              <% if (rolesPermitidos.includes("Oficial_Cumplimiento")) { %>
                <option value="Oficial_Cumplimiento">Oficial de Cumplimiento</option>
              <% } %>
              <% if (rolesPermitidos.includes("Auditoria")) { %>
                <option value="Auditoria">Auditoría</option>
              <% } %>
              <% if (rolesPermitidos.includes("Empleado")) { %>
                <option value="Empleado">Empleado</option>
              <% } %>
              <% if (rolesPermitidos.includes("Cliente")) { %>
                <option value="Cliente">Cliente</option>
              <% } %>
            </select>
          </div>
          <div id="crear-error" class="text-danger small" style="display:none; margin-top:0.5rem;"></div>
          <button class="save-btn" style="margin-top:1rem; width:100%;" id="btn-crear-usuario">Crear usuario</button>
        </div>
      </div>
    </section>
    

  </main>

  <div id="sesion-data" 
    data-id="<%= usuarioSesion ? usuarioSesion.id : 0 %>"
    data-roles="<%= usuarioSesion ? usuarioSesion.roles.join(',') : '' %>"
    style="display:none">
  </div>
  <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
  <script src="/scripts/componentes.js"></script>
  <script src="/scripts/admin.js"></script>
</body>
</html>
