<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link href="https://unpkg.com/gridjs/dist/theme/mermaid.min.css" rel="stylesheet" />    
    <link rel="stylesheet" href="/styles.css">
    <title>Operaciones - Beta 1 </title>
</head>
<body>
  <% const tabActiva = typeof activeTab !== "undefined" ? activeTab : "clientes"; %>
  <% const totalClientesVista = typeof totalClientes !== "undefined" ? totalClientes : "--"; %>
  <% const totalBloqueadosVista = typeof totalBloqueados !== "undefined" ? totalBloqueados : "--"; %>
  <%- include("partials/topbar") %>
  <%- include("partials/sidebar") %>
  <%- include("partials/config") %>
  <%- include("partials/addClientes") %>
  <%- include("partials/panelClientes") %>
  
  <div id="overlay" class="overlay"></div>


 <main class="dashboard">

    <div class="card">
        <h5 class="card-title">Total de Clientes</h5>
        <h6 class="card-subtitle"> </h6>
        <p class="card-nmb" id="total-clientes"> <%= totalClientesVista %> </p>
    </div>

    <div class="card">
        <h5 class="card-title">Clientes Activos</h5>
        <h6 class="card-subtitle"> </h6>
        <p class="card-nmb" id="total-clientes-activos">--</p>
    </div>

    <div class="card">
        <h5 class="card-title">Nuevos Clientes</h5>
        <h6 class="card-subtitle">(ultima semana)</h6>
        <p class="card-nmb" id="total-clientes-nuevos">--</p>
    </div>

    <div class="card">
        <h5 class="card-title">Clientes Bloqueados</h5>
        <h6 class="card-subtitle">  </h6>
        <p class="card-nmb" id="total-clientes-bloqueados"><%= totalBloqueadosVista %></p>
    </div>

    <section class="panel full-page">
    
    
    <div class="clientes-header">
        <div class="clientes-tabs">
        <button class="tab-btn <%= tabActiva === 'clientes' ? 'active' : '' %>" data-table="clientes-section">Clientes</button>
        <button class="tab-btn <%= tabActiva === 'bloqueados' ? 'active' : '' %>" data-table="bloqueados-section">Personas Bloqueadas</button>
        <button class="tab-btn <%= tabActiva === 'listas' ? 'active' : '' %>" data-table="listas-section">Listas de Riesgo</button>
        </div>
        <div class="addCliente">
        <button class="btn btn-light" id="exportClientesCSV">Exportar Clientes</button>
        <button class="btn btn-light" id="addClientes"> Añadir Cliente </button>
        </div>
        
    </div>

    <div id="clientes-section" class="table-section <%= tabActiva === 'clientes' ? 'active' : '' %>">
        <h2>Listado de Clientes</h2>
        <div id="clientes-table"></div>
    </div>

    <div id="bloqueados-section" class="table-section <%= tabActiva === 'bloqueados' ? 'active' : '' %>">
        <h2>Personas Bloqueadas</h2>
        <div id="bloqueados-table"></div>
    </div>

    <div id="listas-section" class="table-section <%= tabActiva === 'listas' ? 'active' : '' %>">
        <div class="clientes-header" style="margin-bottom: 1rem;">
            <h2>Listas de Riesgo</h2>
            <button class="btn btn-light" id="btn-agregar-lista">+ Agregar lista</button>
        </div>
        <div id="listas-table"></div>
    </div>

    </section>

    <div id="lista-modal" class="modal-overlay" style="display:none">
        <div class="modal-box">
            <div class="modal-header">
            <h5 id="lista-modal-titulo">Agregar lista</h5>
            <button id="lista-modal-cerrar" class="btn-close-modal">✕</button>
            </div>
            <div class="modal-body">
            <input type="hidden" id="lista-modal-id">

            <div class="mb-3">
                <label class="form-label">Tipo de lista</label>
                <select id="lista-modal-tipo" class="form-select">
                <option value="PEP">PEP</option>
                <option value="Lista_Negra">Lista Negra</option>
                <option value="Sancion">Sanción</option>
                <option value="Otro">Otro</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input type="text" id="lista-modal-nombre" class="form-control" placeholder="Ej. Lista OFAC, PEP México">
            </div>

            <div class="mb-3">
                <label class="form-label">Fuente</label>
                <input type="text" id="lista-modal-fuente" class="form-control" placeholder="Ej. SHCP, ONU, OFAC">
            </div>

            <div id="lista-modal-error" class="text-danger small" style="display:none"></div>
            </div>
            <div class="modal-footer">
            <button id="lista-modal-cancelar" class="btn btn-light">Cancelar</button>
            <button id="lista-modal-guardar" class="btn btn-primary">Guardar</button>
            </div>
        </div>
        </div>


</main>

<script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
<script src="/scripts/componentes.js"></script>
<script src="/scripts/exportar-csv.js"></script>
<script src="/scripts/clientes.js"></script>


</body>
</html>
