<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <title>Portal del Cliente</title>
</head>
<body class="standalone">
      <%- include("partials/topbar") %>
  <main class="form-page">
    <section class="panel full form-card">
      <span class="form-smltxt">Portal de Clientes</span>
      <h1>Envío de Documentos</h1>

      <form action="/upload_file_private" method="POST" enctype="multipart/form-data" class="document-form">
        <div class="form-field">
          <label for="cliente-nombre">Nombre completo</label>
          <input id="cliente-nombre" type="text" name="nombre" placeholder="Nombre y apellidos">
        </div>

        <div class="form-field">
          <label for="cliente-rfc">RFC</label>
          <input id="cliente-rfc" type="text" name="rfc" maxlength="13" placeholder="13 caracteres">
        </div>

        <div class="form-field">
          <label for="cliente-curp">CURP</label>
          <input id="cliente-curp" type="text" name="curp" maxlength="18" placeholder="18 caracteres">
        </div>

        <div class="form-field file-field">
          <label for="file_input">Subir documento</label>
          <input id="file_input" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png">
          <small>Formatos permitidos: PDF, JPG y PNG.</small>
        </div>

        <button type="submit" class="form-submit">Enviar documento</button>
      </form>
    </section>
  </main>
</body>
</html>
