<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="./styles.css">

    <title>Inicio - AMP</title>
</head>
<body>
  <%- include("partials/topbar") %>
  <%- include("partials/sidebar") %>
  <%- include("partials/cookies") %>
  <%- include("partials/config") %>

  <div id="overlay" class="overlay"></div>

    <main class="dashboard">

    <section class="welcome full">
        <div>
            <h1>¡Bienvenido, <%= usuarioSesion.nombre.trim() %>!</h1>
            <p>Aquí tienes un resumen general de las novedades.</p>
        </div>
    </section>

    <div class="card">
        <h5 class="card-title">Total de reportes</h5>
        <h6 class="card-subtitle"></h6>
        <p class="card-nmb"> 3 </p>
    </div>


    <div class="card">
        <h5 class="card-title">Alertas activas</h5>
        <h6 class="card-subtitle"></h6>
        <p class="card-nmb"> 4 </p>
    </div>

    <div class="card">
        <h5 class="card-title">Operaciones en revisión</h5>
        <h6 class="card-subtitle"></h6>
        <p class="card-nmb"> 3</p>
    </div>

    <div class="card">
        <h5 class="card-title">Casos resueltos</h5>
        <h6 class="card-subtitle"></h6>
        <p class="card-nmb"> --</p>
    </div>

    <section class="panel half">
        <div class="panel-header">
            <h5>Nuevas Personas Bloqueadas</h5>
            <a href="/clientes?tab=bloqueados" class="btn btn-light">Ver Listado</a>
        </div>

        <table class="blocked-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>Carlos Alberto Medina Lopez</td>
                    <td>20/05/2026 11:32</td>
                    <td>+</td>
                </tr>
                <tr>
                    <td>Grupo Financiero Delta</td>
                    <td>20/05/2026 09:15</td>
                    <td>+</td>
                </tr>
                <tr>
                    <td>Comercializadora del Norte S.A.</td>
                    <td>20/05/2026 16:45</td>
                    <td>+</td>
                </tr>
                <tr>
                    <td>Pedro Martinez</td>
                    <td>20/05/2026 14:20</td>
                    <td>+</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="panel half">
        <div class="panel-header">
            <h5>Alertas Recientes</h5> 
            <a href="/alertas" class="btn btn-light">Ver Alertas</a>
        </div>

        <div class="alert-item">
            <i class="circlePrio1"></i>
            <p>Cliente: Carlos Alberto Medina López — Coincidencia PEP</p>
            <span class="alert-time">Hace 10 min</span>
        </div>

        <div class="alert-item">
            <i class="circlePrio2"></i>
            <p>Cliente: Empresa X, S.A. de C.V. — Múltiples operaciones</p>
            <span class="alert-time">Hace 25 min</span>
        </div>

        <div class="alert-item">
            <i class="circlePrio1"></i>
            <p>Cliente: Grupo Financiero Delta — Monto alto inusual</p>
            <span class="alert-time">Hace 40 min</span>
        </div>

        <div class="alert-item">
            <i class="circlePrio3"></i>
            <p>Actualización Lista de Riesgo — Comparación completada</p>
            <span class="alert-time">Hace 1 h</span>
        </div>
    </section>

    <section class="panel full">
        <div class="panel-header">
            <h5>Operaciones Recientes</h5>
            <a href="/operations" class="btn btn-light"> Ver Operaciones</a>

        </div>

        <table class="blocked-table">
            <thead>
                <tr>
                    <th>ID Cliente</th>
                    <th>Tipo Producto</th>
                    <th>Monto</th>
                    <th>Estatus</th>
                    <th>Vigencia</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td> CL-0001 </td>
                    <td> Credito Personal </td>
                    <td>$50,000.00</td>
                    <td><span>Activo</span></td>
                    <td>22/06/2026</td>
                </tr>
                <tr>
                    <td> CL-0002 </td>
                    <td>Factoraje</td>
                    <td>$120,000.00</td>
                    <td><span>En Proceso</span></td>
                    <td>27/05/2026</td>
                </tr>
                <tr>
                    <td> CL-0003</td>
                    <td>Disposición</td>
                    <td>$75,000.00</td>
                    <td><span>Vencido</span></td>
                    <td>04/05/2026</td>
                </tr>
                <tr>
                    <td> CL-0004 </td>
                    <td>Factoraje</td>
                    <td>$30,000.00</td>
                    <td><span>Activo</span></td>
                    <td>30/06/2026</td>
                </tr>
            </tbody>
        </table>
    </section>

</main>
    <script src="./scripts/componentes.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
