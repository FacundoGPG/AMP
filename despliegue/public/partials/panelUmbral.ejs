<div id="umbralOverlay" class="overlay"></div>

<aside id="umbralPanel" class="cliente-panel">
  <div class="cliente-panel-header">
    <div>
      <p>Umbral personalizado</p>
      <h3 id="umbral-panel-titulo">Nuevo umbral</h3>
    </div>
    <button type="button" id="cerrarUmbralPanel" aria-label="Cerrar">X</button>
  </div>

  <div style="padding: 1rem; display: flex; flex-direction: column; gap: 1rem;">

    <div>
      <label class="form-label">Nombre</label>
      <input type="text" id="umbral-modal-nombre" class="form-control"
        placeholder="Ej. Límite especial cliente VIP">
    </div>

    <div>
      <label class="form-label">Tipo de alerta</label>
      <select id="umbral-modal-tipo" class="form-select">
        <option value="Operacion alta">Operacion alta</option>
        <option value="Operacion critica">Operacion critica</option>
        <option value="Transferencia">Transferencia</option>
        <option value="Operacion inusual">Operacion inusual</option>
      </select>
    </div>

    <div>
      <label class="form-label">Valor límite ($)</label>
      <input type="number" id="umbral-modal-valor" class="form-control"
        min="0" step="0.01" placeholder="0.00">
    </div>

    <div>
      <label class="form-label">Nivel</label>
      <select id="umbral-modal-nivel" class="form-select">
        <option value="Baja">Baja</option>
        <option value="Media">Media</option>
        <option value="Alta">Alta</option>
      </select>
    </div>

    <div>
      <label class="form-label">Descripción</label>
      <input type="text" id="umbral-modal-descripcion" class="form-control"
        placeholder="Descripción breve">
    </div>

    <div id="umbral-modal-error" class="text-danger small" style="display:none"></div>

    <button id="umbral-modal-guardar" class="save-btn" style="width:100%;">
      Guardar umbral
    </button>

  </div>
</aside>