<div id="clienteOverlay" class="overlay"></div> 
<aside id="clientePanel" class="cliente-panel">
    <div class="cliente-panel-header">
        <div>
            <p>Resumen de cliente</p>
            <h3 id="cliente-detail-nombre"></h3>
        </div>
        <button type="button" id="cerrarClientePanel" aria-label="Cerrar detalle">X</button>
    </div>
    <div class="btn-group cliente-panel-tabs" role="group" aria-label="Secciones del cliente">
        <button type="button" class="btn btn-light cliente-panel-tab active" data-panel-tab="cliente-info-tab">
            Información general
        </button>

        <button type="button" class="btn btn-light cliente-panel-tab" data-panel-tab="cliente-operaciones-tab">
            Operaciones
        </button>

        <button type="button" class="btn btn-light cliente-panel-tab" data-panel-tab="cliente-alertas-tab">
            Alertas
        </button>
    </div>

    <section id="cliente-info-tab" class="cliente-panel-section active">
    <div class="detail-grid">
        <div>
            <p>RFC:</p>
            <strong id="cliente-detail-rfc">---</strong>
        </div>
        <div>
            <p>Tipo:</p>
            <strong id="cliente-detail-tipo">---</strong>
        </div>
        <div>
            <p>Correo:</p>
            <strong id="cliente-detail-correo">---</strong>
        </div>
        <div>
            <p>Telefono:</p>
            <strong id="cliente-detail-telefono">---</strong>
        </div>
        <div>
            <p>Estatus:</p>
            <strong id="cliente-detail-estatus">---</strong>
        </div>
        <div>
            <p>Fecha de registro:</p>
            <strong id="cliente-detail-fecha">---</strong>
        </div>
        <div class="detail-block">
            <p>Domicilio:</p>
            <strong id="cliente-detail-domicilio">---</strong>
        </div>
    </div>
    </section>

    <section id="cliente-operaciones-tab" class="cliente-panel-section">
        <h4>Operaciones del cliente</h4>
        <div id="cliente-operaciones-list" class="cliente-preview-list">
            Selecciona un cliente para ver sus operaciones.
        </div>
    </section>

    <section id="cliente-alertas-tab" class="cliente-panel-section">
        <h4>Alertas del cliente</h4>
        <div id="cliente-alertas-list" class="cliente-preview-list">
            Selecciona un cliente para ver sus alertas.
        </div>
    </section>
</aside>
