<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <title>Portal del Cliente</title>
</head>
<body class="standalone">
      <%- include("partials/topbar") %>
  <main>
    <section class="panel full">
      <h1>Envío de Documentos</h1>

      <form action="/upload_file_private" method="POST" enctype="multipart/form-data">
        <label>Nombre completo:</label>
        <input type="text" name="nombre">

        <label>RFC:</label>
        <input type="text" name="rfc" maxlength="13">

        <label>CURP:</label>
        <input type="text" name="curp" maxlength="18">

        <label for="file_input">Subir Documento</label>
        <input id="file_input" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png">

        <button type="submit">Enviar</button>
      </form>
    </section>
  </main>
</body>
</html>